# Copy this file to .env and fill in your own key. .env is gitignored --
# never commit a real key.
#
# Without ANTHROPIC_API_KEY set, the app still runs fully -- Phases 1-5
# (parsing, ATS structural rules, deterministic keyword coverage) always
# work for free. Setting this key additionally enables the LLM-powered
# scores: Target Role Alignment, Program Management Positioning (bullet
# quality), Recruiter Readability, Executive/Seniority Signal, Overall
# Resume Strength, and JD Requirement Coverage Matrix (when a job
# description is pasted). Each analysis with a key configured makes a
# small number of real Anthropic API calls -- normal per-token usage
# charges apply to your account.

ANTHROPIC_API_KEY=

# Optional -- defaults to claude-sonnet-5 if unset.
LLM_MODEL=claude-sonnet-5
